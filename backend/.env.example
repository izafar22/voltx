# Local development example only. Never overwrite live Render configuration.
APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27019
DB_NAME=rushx_auth_development
JWT_SECRET=replace-with-a-fresh-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
OTP_MODE=provider
EXPOSE_DEMO_OTP=false
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
# Use an approved MSG91 SMS template ID, not the raw DLT content-template ID.
MSG91_TEMPLATE_ID=
# Six-letter DLT header configured on the template (not sent as an undocumented API field).
MSG91_SENDER_ID=
# Exact, case-sensitive variable name in that template; example only:
MSG91_OTP_VARIABLE=otp
# Preserve existing Google settings; never place a client secret in frontend configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
WHATSAPP_ENABLED=false

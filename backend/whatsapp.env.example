# All approvals are UNKNOWN until verified by a human. This mapping fails closed.
# Copy only exact approved names/locales/parameter order; see templates/WHATSAPP_SUBMISSION.md.
WHATSAPP_TEMPLATES_JSON='{"REQUESTED":{"name":"rushx_repair_requested_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number","charger_description"],"approval_status":"unknown"},"AWAITING_SHIPMENT":{"name":"rushx_awaiting_shipment_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number","dispatch_address"],"approval_status":"unknown"},"RECEIVED_AT_VOLTX":{"name":"rushx_charger_received_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number"],"approval_status":"unknown"},"ESTIMATE_SENT":{"name":"rushx_estimate_ready_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number","estimate_total"],"approval_status":"unknown"},"CUSTOMER_APPROVED":{"name":"rushx_estimate_approved_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number"],"approval_status":"unknown"},"REPAIR_COMPLETED":{"name":"rushx_repair_completed_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number"],"approval_status":"unknown"},"PAYMENT_PENDING":{"name":"rushx_payment_pending_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number","amount_due"],"approval_status":"unknown"},"SHIPPED_TO_CUSTOMER":{"name":"rushx_return_shipped_v1","language":"en_US","category":"UTILITY","parameters":["customer_name","repair_number","courier","tracking_number"],"approval_status":"unknown"}}'

# Copy these keys into backend/.env or your secret manager; defaults send nothing.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=test
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Select a currently supported Graph API version in your Meta app dashboard.
WHATSAPP_API_VERSION=
# Comma-separated E.164 recipients explicitly added to Meta's test environment.
WHATSAPP_TEST_RECIPIENTS=
# Supply the actual RushX service/dispatch address before enabling repair templates.
RUSHX_DISPATCH_ADDRESS=
# Map each supported internal status to an approved template name, language and
# positional body parameter keys. Empty by default: unconfigured jobs dead-letter.
WHATSAPP_TEMPLATES_JSON='{}'
